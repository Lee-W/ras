{
  "name": "@ras/slide-kit",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "description": "RAISE A SLIDE \u2014 standalone Marp projects and AI presentation workflows",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "ras": "scripts/ras.mjs"
  },
  "scripts": {
    "docs": "node scripts/docs.mjs",
    "init:deck": "node scripts/ras.mjs init",
    "build": "node scripts/deck.mjs build",
    "check": "node scripts/deck.mjs check",
    "export": "node scripts/deck.mjs export",
    "preview": "node scripts/deck.mjs preview",
    "doctor": "node scripts/deck.mjs doctor",
    "status": "node scripts/review.mjs status",
    "review:record": "node scripts/review.mjs record",
    "memory": "node scripts/memory.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:mutation": "node scripts/mutation-check.mjs",
    "test:release": "node scripts/release-check.mjs",
    "validate": "node scripts/validate.mjs"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "puppeteer-core": "25.11.0"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-tc": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@fontsource/roboto-condensed": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "@marp-team/marp-cli": "4.5.1",
    "@marp-team/marp-core": "4.4.0",
    "@mermaid-js/mermaid-cli": "11.17.0",
    "pdf-lib": "1.17.1",
    "puppeteer": "25.11.0"
  }
}
